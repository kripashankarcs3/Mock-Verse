# ── Server ──────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000
MONGO_TIMEOUT_MS=5000

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://dummy:dummy@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# ── Firebase Admin ──────────────────────────────────────────────────────────
# Absolute or relative path to the service account JSON (never commit it).
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ── Judge0 CE ───────────────────────────────────────────────────────────────
# Defaults to the free public API (https://ce.judge0.com) when no key is set.
# For RapidAPI: set URL to https://judge0-ce.p.rapidapi.com and provide a key.
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=
